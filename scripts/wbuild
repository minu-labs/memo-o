#!/usr/bin/env bash
# WSL에서 build.ps1 실행 (네트워크 경로의 .ps1 실행 제한을 피하기 위해 스크립트 블록으로 로드)
ROOT='\\wsl.localhost\Ubuntu\home\hg623\memo-o'
cd /mnt/c && exec powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \
  "Set-Location '$ROOT'; & ([scriptblock]::Create((Get-Content -Raw -Encoding UTF8 .\\build.ps1))) $*" < /dev/null
